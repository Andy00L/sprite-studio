# Sprite Studio environment template.
#
# Two scopes live here:
#   1. Secrets that belong in ~/.hermes/.env (Hermes-wide secrets file).
#   2. Optional bridge-launcher overrides that belong in ./env (repo root)
#      or your shell environment when running `npm run dev`.
#
# DO NOT commit a populated .env or ~/.hermes/.env.

# ============================================================================
# Scope 1: copy this block into ~/.hermes/.env
# ============================================================================

# ----- REQUIRED for Sprite Studio -----

# TokenRouter (LLM, image, video proxy: Kimi, gpt-image-2, Seedance)
TOKENROUTER_API_KEY=<your-tokenrouter-key>

# ElevenLabs (narration TTS)
ELEVENLABS_API_KEY=<your-elevenlabs-key>

# Hermes API server / bridge auth (generate with: openssl rand -hex 16)
# Must match VITE_SPRITE_BRIDGE_KEY in web/.env.local
API_SERVER_KEY=<random-hex-32>

# ----- OPTIONAL (Sprite Studio surfaces and tunables) -----

# OpenAI direct (only if bypassing TokenRouter for gpt-image-2)
OPENAI_API_KEY=<your-openai-key>

# Video render tier: 'fast' (default, cheaper) or 'standard'
SPRITE_STUDIO_VIDEO_TIER=fast

# Telegram bot surface (optional)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_ALLOWED_USERS=<comma-separated-telegram-user-ids>

# ----- OPTIONAL (Hermes-wide; other plugins; leave unset for Sprite Studio) -----

# Hermes core
HERMES_MAX_ITERATIONS=<int-max-agent-loop-iterations>

# Per-toolset debug flags (true/false)
IMAGE_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
WEB_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false

# Browserbase (browser automation plugin)
BROWSERBASE_ADVANCED_STEALTH=<true-or-false>
BROWSERBASE_PROXIES=<true-or-false>
BROWSER_INACTIVITY_TIMEOUT=<seconds>
BROWSER_SESSION_TIMEOUT=<seconds>

# Terminal plugin
TERMINAL_LIFETIME_SECONDS=<seconds>
TERMINAL_MODAL_IMAGE=<modal-image-tag>
TERMINAL_TIMEOUT=<seconds>

# ============================================================================
# Scope 2: copy this block into ./env (repo root) or your shell environment
# These are OPTIONAL overrides for `npm run dev`.
# ============================================================================

# Override the Hermes home directory. Defaults to ~/.hermes.
# HERMES_HOME=/path/to/.hermes

# Override the bridge bind host. Defaults to 127.0.0.1. Do not bind to
# 0.0.0.0 unless you understand that the bridge has Bearer auth but no
# rate limiting.
# SPRITE_BRIDGE_HOST=127.0.0.1

# Override the bridge port. Defaults to 8643. Must match the Vite proxy
# in web/vite.config.ts; if you change one you must change both.
# SPRITE_BRIDGE_PORT=8643

# Override the plugin directory. Defaults to ~/.hermes/plugins/sprite-studio.
# SPRITE_PLUGIN_PATH=/path/to/sprite-studio
