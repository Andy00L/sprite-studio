# Sprite Studio web app environment template.
# Copy to web/.env.local and fill.

# Must match API_SERVER_KEY in ~/.hermes/.env (the root .env.example shows how)
VITE_SPRITE_BRIDGE_KEY=<same-as-API_SERVER_KEY>

# Asset server base URL (where the bridge serves rendered media).
# Default works for local dev; override only for tunneled or remote setups.
VITE_ASSET_BASE_URL=http://127.0.0.1:9120
